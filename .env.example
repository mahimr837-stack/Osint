# ---------------------------------------------------------------------------
# Traceboard — Server Environment Configuration
# Copy this file to .env and fill in the API keys for the providers you use.
# ---------------------------------------------------------------------------

# Primary AI Provider (ChatNode, DorkNode, GeoIntelNode, SuspectNode Imagen 3)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Geolocation AI (GeoSpyNode — https://geospy.ai)
GEOSPY_API_KEY=""

# Optional Multi-Provider LLM & Image Generation Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
MISTRAL_API_KEY=""

# Server Configuration (defaults shown — set HOST="0.0.0.0" to expose over LAN for mobile sync)
HOST="127.0.0.1"
PORT="3000"
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000,http://localhost:5173"
OSINT_TIMEOUT_MS="5000"
